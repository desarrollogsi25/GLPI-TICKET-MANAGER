# =============================================================================
# Production Environment Variables Template (.env.prod)
# Security Notice: NEVER commit the actual `.env.prod` with real secrets to Git.
# =============================================================================

# ── Application Port ──────────────────────────────────────────────────────────
PROD_HTTP_PORT=80

# ── PostgreSQL Production Database (app-db) ──────────────────────────────────
POSTGRES_DB=glpi_ticket_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>

# ── GLPI External Database Access (MariaDB) ───────────────────────────────────
GLPI_DB_HOST=glpi-db
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=<CHANGE_ME_GLPI_DB_PASSWORD>

# ── GLPI REST API Integration ────────────────────────────────────────────────
GLPI_API_BASE_URL=http://glpi:80/apirest.php
GLPI_APP_TOKEN=<CHANGE_ME_GLPI_APP_TOKEN>
GLPI_USER_TOKEN=<CHANGE_ME_GLPI_USER_TOKEN>

# ── JWT Authentication (Min 32 characters, HMAC-SHA256) ──────────────────────
JWT_SECRET=<CHANGE_ME_MIN_32_CHARACTERS_JWT_SECRET_KEY>
JWT_ISSUER=GlpiTicketManager
JWT_AUDIENCE=GlpiTicketManager
JWT_EXPIRY_MINUTES=480

# ── Structured Telemetry & Seq (Optional) ─────────────────────────────────────
SEQ_SERVER_URL=http://seq:5341
SEQ_PORT=5341
SEQ_ADMIN_PASSWORD_HASH=
