# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and replace every <change-me> with a real value.
# `.env` is git-ignored and is read by docker compose for ${...} interpolation.
# ─────────────────────────────────────────────────────────────────────────────

# ── MariaDB (GLPI database) ──────────────────────────────────────────────────
# Consumed by: docker-compose.yml -> services `glpi-db` (container init) and
#              `api` (Database__ConnectionString).
# Location:    root `.env`.
MARIADB_ROOT_PASSWORD=<change-me>
MARIADB_DATABASE=glpi
MARIADB_USER=glpi
MARIADB_PASSWORD=<change-me>

# ── GLPI REST API tokens ─────────────────────────────────────────────────────
# Consumed by: docker-compose.yml -> service `api` (GlpiApi__AppToken / GlpiApi__UserToken).
# Location:    root `.env` for the compose stack; on a host-side dev run they live
#              in .NET user-secrets instead (see docs/12-security/secrets.md).
# Source:      App token  -> GLPI -> Setup -> General -> API clients.
#              User token -> GLPI -> the write account -> Preferences -> API token.
GLPI_APP_TOKEN=<change-me>
GLPI_USER_TOKEN=<change-me>

# ── API JWT signing key ──────────────────────────────────────────────────────
# Consumed by: docker-compose.yml -> service `api` (Jwt__Key).
# Location:    root `.env` for the compose stack; host-side dev uses user-secrets.
# Rule:        HMAC-SHA256, minimum 32 characters (the API refuses to boot otherwise).
JWT_SECRET=<change-me>

# PostgreSQL para datos propios del sistema (ADR-012)
APP_DB_PASSWORD=<change-me-strong-password>
