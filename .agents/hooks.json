{
  "gitnexus-graph-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/tools/hooks/gate.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/tools/hooks/gate.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
