{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:80",
      "http://localhost",
      "http://127.0.0.1"
    ]
  },
  "GlpiWebhook": {
    "Secret": ""
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30
  },
  "AppDb": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30
  },
  "GlpiApi": {
    "BaseUrl": "http://localhost:8081/apirest.php/",
    "AppToken": "",
    "UserToken": "",
    "TimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "GlpiTicketManager.Api",
    "Audience": "GlpiTicketManager.Frontend",
    "Key": "",
    "ExpiryMinutes": 60
  },
  "RateLimiting": {
    "ExpensiveTokenLimit": 20,
    "ExpensiveTokensPerPeriod": 1,
    "ExpensiveReplenishmentSeconds": 3,
    "PerUserRequestLimit": 100,
    "LoginAttemptLimit": 5
  }
}
